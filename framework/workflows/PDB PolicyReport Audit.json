      {
        "parameters": {
          "jsCode": "return ['gold', 'golddr', 'silver', 'klab', 'clab', 'emerald', 'klab2'].map((cluster) => ({\n  json: { cluster, tokenName: `PDB_reader_${cluster}` },\n}));"
        },
        "id": "134031fc-eb01-4f2e-b75b-76eae747a395",
        "name": "Clusters",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          18912,
          8096
        ]
      },
      {
        "parameters": {
          "workflowId": "28",
          "options": {}
        },
        "id": "f37ed0f6-101c-44e1-87f2-ea0575f6b510",
        "name": "Build Login Command",
        "type": "n8n-nodes-base.executeWorkflow",
        "typeVersion": 1,
        "position": [
          19360,
          7712
        ],
        "alwaysOutputData": true
      },
      {
        "parameters": {
          "command": "=#!/usr/bin/env bash\nset -euo pipefail\n\nCLUSTER='{{ $json.cluster }}'\nexport KUBECONFIG=\"/tmp/pdb-policyreport-${CLUSTER}.kubeconfig\"\ntrap 'rm -f \"$KUBECONFIG\"' EXIT\n\n{{ $json.ocLogin }}\nprintf 'cluster\\tnamespace\\tpolicy\\trule\\tresult\\tmessage\\tresources\\n'\noc get policyreports.wgpolicyk8s.io -A -o json | jq -r --arg cluster \"$CLUSTER\" '\n  .items[] as $pr\n  | ($pr.metadata.namespace // \"-\") as $ns\n  | $pr.results[]?\n  | select((.policy | test(\"^pdb-replicas-\")) and .result == \"fail\")\n  | [\n      $cluster,\n      $ns,\n      .policy,\n      .rule,\n      .result,\n      (.message // \"\" | gsub(\"\\n\"; \" \")),\n      ((.resources // []) | map((.kind // \"?\") + \"/\" + (.name // \"?\")) | join(\",\"))\n    ]\n  | @tsv\n'"
        },
        "id": "1ca4c893-9625-44f9-8053-520a1e2c3ee8",
        "name": "Find Failed PDB PolicyReports",
        "type": "n8n-nodes-base.executeCommand",
        "typeVersion": 1,
        "position": [
          19584,
          8000
        ]
      },
      {
        "parameters": {
          "jsCode": "const header = 'cluster\\tnamespace\\tpolicy\\trule\\tresult\\tmessage\\tresources';\nconst namespaces = new Map();\n\nfor (const { json } of $input.all()) {\n  const rows = String(json.stdout || '').trim().split('\\n');\n  const headerIndex = rows.indexOf(header);\n  if (headerIndex < 0) continue;\n\n  for (const row of rows.slice(headerIndex + 1)) {\n    const [cluster, namespace] = row.split('\\t');\n    if (cluster && namespace) namespaces.set(`${cluster}/${namespace}`, { cluster, namespace });\n  }\n}\n\nreturn [{ json: { misconfiguredNamespaces: [...namespaces.values()] } }];"
        },
        "id": "893042c4-c232-4acb-a5ec-5b0872118165",
        "name": "Gather Misconfigured Namespaces",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          19376,
          8000
        ]
      },
      {
        "parameters": {
          "command": "=#!/usr/bin/env bash\nset -euo pipefail\n\ncredential=$(n8n export:credentials --all --decrypted | grep -o '\\[{.*\\}]' | jq -c '.[] | select(.name == \"Registry_API_Credential\") | {clientId: .data.name, clientSecret: .data.value}')\nclient_id=$(jq -er '.clientId' <<<\"$credential\")\nclient_secret=$(jq -er '.clientSecret' <<<\"$credential\")\n\ncurl -fsS -X POST \\\n  -H 'Content-Type: application/x-www-form-urlencoded' \\\n  --data-urlencode 'grant_type=client_credentials' \\\n  --data-urlencode \"client_id=$client_id\" \\\n  --data-urlencode \"client_secret=$client_secret\" \\\n  'https://loginproxy.gov.bc.ca/auth/realms/platform-services/protocol/openid-connect/token' \\\n  | jq -er '.access_token'"
        },
        "id": "2f95a72a-bb45-492e-8a03-5feb69121bfb",
        "name": "Get Registry Access Token",
        "type": "n8n-nodes-base.executeCommand",
        "typeVersion": 1,
        "position": [
          19584,
          8192
        ]
      },
      {
        "parameters": {
          "jsCode": "return [{\n  json: {\n    accessToken: String($json.stdout || '').trim(),\n    misconfiguredNamespaces: $('Gather Misconfigured Namespaces').first().json.misconfiguredNamespaces,\n  },\n}];"
        },
        "id": "ada0584b-0b1f-473a-883e-b0688c0b9e23",
        "name": "Attach Findings to Registry Token",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          19808,
          8192
        ]
      },
      {
        "parameters": {
          "jsCode": "const { accessToken, misconfiguredNamespaces = [] } = $input.first().json;\nconst products = new Map();\n\nfor (const finding of misconfiguredNamespaces) {\n  const licencePlate = String(finding.namespace).slice(0, 6);\n  if (!products.has(licencePlate)) products.set(licencePlate, []);\n  products.get(licencePlate).push(finding);\n}\n\nreturn [...products].map(([licencePlate, namespaces]) => ({\n  json: { accessToken, licencePlate, namespaces },\n}));"
        },
        "id": "eedce93c-caec-43cb-9c5a-cfed80b363e3",
        "name": "Build Registry Lookup Items",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          20032,
          8192
        ]
      },
      {
        "parameters": {
          "command": "=curl -fsS \\\n  -H \"Authorization: Bearer {{ $json.accessToken }}\" \\\n  \"https://registry.developer.gov.bc.ca/api/v1/private-cloud/products/{{ $json.licencePlate }}\""
        },
        "id": "c420e708-39c1-4ee7-a0ae-d2fe4d45173e",
        "name": "Get Registry Products",
        "type": "n8n-nodes-base.executeCommand",
        "typeVersion": 1,
        "position": [
          20416,
          8528
        ]
      },
      {
        "parameters": {
          "jsCode": "const lookups = $('Build Registry Lookup Items').all();\n\nreturn $input.all().map((item, index) => {\n  const response = JSON.parse(item.json.stdout);\n  if (!response.success || !response.data) {\n    throw new Error(`Registry lookup failed for ${lookups[index].json.licencePlate}`);\n  }\n\n  const product = response.data;\n  const contacts = [\n    ['projectOwner', product.projectOwner],\n    ['primaryTechnicalLead', product.primaryTechnicalLead],\n    ['secondaryTechnicalLead', product.secondaryTechnicalLead],\n  ]\n    .filter(([, contact]) => contact)\n    .map(([role, contact]) => ({\n      role,\n      name: [contact.firstName, contact.lastName].filter(Boolean).join(' '),\n      email: contact.email,\n    }));\n\n  return {\n    json: {\n      licencePlate: lookups[index].json.licencePlate,\n      productName: product.name,\n      contacts,\n      namespaces: lookups[index].json.namespaces,\n    },\n  };\n});"
        },
        "id": "db1d5ab2-c87b-4b4f-93af-c602b74a65ad",
        "name": "Extract Registry Contacts",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          20480,
          8288
        ]
      },
      {
        "parameters": {
          "content": "## Failed PDB policy reports\n\nRuns every Sunday at 10:00 PM, America/Vancouver. It finds failed `pdb-replicas-*` policy reports for gold, golddr, silver, klab, clab, emerald, and klab2, then gets Registry contacts for each affected licence plate.\n\nCredentials are named `PDB_reader_<cluster>` and use the shared OC Login component (workflow 28). `Registry_API_Credential` stores the Registry client ID and secret.",
          "height": 260,
          "width": 760
        },
        "id": "758ea7ae-fa45-4d89-a95d-7e42dc981218",
        "name": "How this works",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [
          18896,
          7456
        ]
      }
    ],
