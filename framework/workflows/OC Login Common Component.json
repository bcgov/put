    "nodes": [
      {
        "parameters": {
          "content": "## Build OC Login Command\n\nThis workflow gets called while providing the **tokenName** in the calling workflow. \n\nThe workflow will find the token from the credential and will build the `oc login` statement that you can use.\n\n### Do not change this workflow as it is a common component used by other workflows.",
          "height": 217,
          "width": 717
        },
        "id": "3aab9cb8-98d6-45de-84e4-f433d98aabb5",
        "name": "Sticky Note",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [
          1200,
          -112
        ]
      },
      {
        "parameters": {
          "command": "=n8n export:credentials --all --decrypted | grep -o '\\[{.*\\}]'|jq -r '.[] | select(.name == \"{{ $node[\"Execute Workflow Trigger\"].json.tokenName }}\").data.value' | tr -d '\\n'"
        },
        "id": "d8a1ea4b-15ac-41a9-8b30-84e21a9b823e",
        "name": "Get Token",
        "type": "n8n-nodes-base.executeCommand",
        "typeVersion": 1,
        "position": [
          1440,
          128
        ]
      },
      {
        "parameters": {
          "command": "=n8n export:credentials --all --decrypted | grep -o '\\[{.*\\}]' | jq -r '.[] | select(.name == \"{{ $node[\"Execute Workflow Trigger\"].json.tokenName }}\").data.name' | sed \"s/<token>/{{ $json.stdout }}/g\" "
        },
        "id": "097fb6ad-0e00-4caf-92e0-8f6441a84c3f",
        "name": "Build Login",
        "type": "n8n-nodes-base.executeCommand",
        "typeVersion": 1,
        "position": [
          1584,
          128
        ]
      },
      {
        "parameters": {},
        "id": "11d8b456-08c3-4e61-aaa5-31e2e311c228",
        "name": "Execute Workflow Trigger",
        "type": "n8n-nodes-base.executeWorkflowTrigger",
        "typeVersion": 1,
        "position": [
          1248,
          128
        ]
      },
      {
        "parameters": {
          "jsCode": "const inputs = $('Execute Workflow Trigger').all();\nreturn $input.all().map((item, index) => ({\n  json: { ...inputs[index].json, ocLogin: item.json.stdout },\n}));"
        },
        "id": "e48d4204-0de5-4ed1-8ee8-834e97f0a9bc",
        "name": "Code",
        "type": "n8n-nodes-base.code",
        "typeVersion": 1,
        "position": [
          1744,
          128
        ]
      }
